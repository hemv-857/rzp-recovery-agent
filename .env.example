# Copy to .env. Leave keys empty to run fully in simulation mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional LLM for free-form failure-reason classification + nudge copy.
# Any OpenAI-compatible endpoint works. Empty => deterministic templates.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Future: Razorpay Vulcan foundation model (announced Aug 2026, no public
# merchant API yet). Set VULCAN_API_URL when available and classification
# routes through it first — silent fallback to the rule table otherwise.
# Assumed contract documented in app/classifier_vulcan.py.
VULCAN_API_URL=
VULCAN_API_KEY=

# Optional voice BSP / TTS webhook (Exotel/Knowlarity/GCP-TTS wrapper).
# When set, NUDGE_VOICE actions POST {to, tts_script, sms_followthrough} as JSON.
VOICE_PROVIDER_URL=

# Shared secret for operator endpoints (/tick, /cases/*/approve,
# /cases/*/opt_out) — sent as the X-Agent-Token header. Empty = open
# (local dev only; never leave it open on a public URL).
AGENT_API_TOKEN=

# Requests per minute per client IP (fixed window, in-process). 429 +
# Retry-After beyond the limit. Per-process counters: run one uvicorn worker
# or front with a gateway for cluster-wide limits.
RATE_LIMIT_PER_MIN=120

# Optional Slack incoming-webhook for ops alerts (escalations to finance ops,
# customer opt-outs/refusals). Empty = silent; alert failures never crash the loop.
SLACK_WEBHOOK_URL=

# Optional multi-tenancy: send X-Merchant-Id per request to route each merchant
# to its own isolated DB file (recovery_<merchant>.db). Unset = single tenant
# using RECOVERY_DB as-is.
# X-MERCHANT-ID=

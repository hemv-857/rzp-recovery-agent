{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://rzp-recovery-agent.onrender.com/$1" },
    { "source": "/ws/(.*)", "destination": "https://rzp-recovery-agent.onrender.com/ws/$1" },
    { "source": "/audit/(.*)", "destination": "https://rzp-recovery-agent.onrender.com/audit/$1" },
    { "source": "/static/(.*)", "destination": "https://rzp-recovery-agent.onrender.com/static/$1" },
    { "source": "/docs", "destination": "https://rzp-recovery-agent.onrender.com/docs" },
    { "source": "/openapi.json", "destination": "https://rzp-recovery-agent.onrender.com/openapi.json" },
    { "source": "/report", "destination": "https://rzp-recovery-agent.onrender.com/report" },
    { "source": "/report/baseline", "destination": "https://rzp-recovery-agent.onrender.com/report/baseline" },
    { "source": "/cases/(.*)", "destination": "https://rzp-recovery-agent.onrender.com/cases/$1" },
    { "source": "/security/(.*)", "destination": "https://rzp-recovery-agent.onrender.com/security/$1" },
    { "source": "/analytics/(.*)", "destination": "https://rzp-recovery-agent.onrender.com/analytics/$1" },
    { "source": "/budget", "destination": "https://rzp-recovery-agent.onrender.com/budget" },
    { "source": "/incidents", "destination": "https://rzp-recovery-agent.onrender.com/incidents" },
    { "source": "/approval/(.*)", "destination": "https://rzp-recovery-agent.onrender.com/approval/$1" },
    { "source": "/calculator(.*)", "destination": "https://rzp-recovery-agent.onrender.com/calculator$1" },
    { "source": "/batch/(.*)", "destination": "https://rzp-recovery-agent.onrender.com/batch/$1" },
    { "source": "/inbound/(.*)", "destination": "https://rzp-recovery-agent.onrender.com/inbound/$1" },
    { "source": "/tick", "destination": "https://rzp-recovery-agent.onrender.com/tick" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
